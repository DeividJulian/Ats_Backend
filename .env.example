# Cadena de conexión de PostgreSQL (se puede pegar tal cual la que da Neon)
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Orígenes que pueden llamar a la API, separados por comas (por ejemplo la URL del front). * permite todos
ALLOWED_ORIGINS=*

# Permite POST /seed?reset=true, que BORRA todos los datos. Déjalo en false en producción
ALLOW_DATA_RESET=true

# IA opcional (sin clave, los endpoints /ai responden 503 y el resto funciona igual)
# Proveedor: gemini (gratis, por defecto), groq o anthropic
AI_PROVIDER=gemini
# Clave del proveedor. Gemini: https://aistudio.google.com -> Get API key
AI_API_KEY=
# Opcional: otro modelo (por defecto gemini-3.8-flash; groq: openai/gpt-oss-20b; anthropic: claude-opus-5-5)
AI_MODEL=gemini-3.8-flash
# Modelo de respaldo cuando el principal está saturado (503), sin cuota (429) o lento. En Gemini: gemini-flash-lite-latest por defecto; none lo apaga
# AI_FALLBACK_MODEL=gemini-flash-lite-latest
# Opcional: otra dirección del endpoint compatible con OpenAI
# AI_BASE_URL=

# Clave para firmar las sesiones y los códigos (mínimo 32 caracteres). Si falta, se genera una temporal al arrancar
SECRET_KEY=
# Duración de la sesión en horas
TOKEN_HORAS=12

# Envío de los códigos de acceso: consola (local, el código sale en la terminal), memoria, smtp o brevo
EMAIL_BACKEND=consola
# Remitente. Con Brevo debe ser un remitente verificado en tu cuenta
EMAIL_FROM=
EMAIL_FROM_NAME=Portal ATS
# Brevo: Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
# Opcional, solo con EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Códigos: minutos de vigencia, intentos y segundos de espera entre envíos
CODIGO_MINUTOS=10
CODIGO_INTENTOS=5
CODIGO_ESPERA_SEGUNDOS=30

# Primer administrador: se crea al arrancar si no existe y entra con el código que llega a ese correo
ADMIN_EMAIL=
