# Cadena de conexión de PostgreSQL (se puede pegar tal cual la que da Neon)
DATABASE_URL=postgresql://usuario:clave@host:5432/base

# Orígenes que pueden llamar a la API, separados por comas (por ejemplo la URL del front). * permite todos
ALLOWED_ORIGINS=*

# Permite POST /seed?reset=true, que BORRA todos los datos. Déjalo en false en producción
ALLOW_DATA_RESET=true

# IA opcional (sin clave, los endpoints /ai responden 503 y el resto funciona igual)
# Proveedor: gemini (gratis, por defecto), groq o anthropic
AI_PROVIDER=gemini
# Clave del proveedor. Gemini: https://aistudio.google.com -> Get API key
AI_API_KEY=
# Opcional: otro modelo (por defecto gemini-3.8-flash; groq: openai/gpt-oss-20b; anthropic: claude-opus-5-5)
AI_MODEL=gemini-3.8-flash
# Opcional: otra dirección del endpoint compatible con OpenAI
# AI_BASE_URL=

# Clave para firmar las sesiones (mínimo 32 caracteres). Si falta, se genera una temporal al arrancar
JWT_SECRET=

# Primer administrador: se crea al arrancar si no existe (la contraseña debe tener al menos 8 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=
